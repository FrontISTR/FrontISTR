# Runs PROGRAM on the mesh of INPUT followed by the analysis data of CASE, and checks
# the exit status and the messages, which give the lines of the inp file.
cmake_policy(SET CMP0054 NEW)

file(READ "${INPUT}" mesh)
string(FIND "${mesh}" "*boundary" mesh_end)
string(SUBSTRING "${mesh}" 0 ${mesh_end} mesh)
string(REGEX MATCHALL "\n" lines "${mesh}")
list(LENGTH lines n)

# The k-th line of the analysis data is the line n+k of the inp file.
set(analysis "*BOUNDARY\nFIX, 1, 3\n*STEP\n*STATIC\n*CLOAD\nTIP, 3, -1\n*END STEP\n")
set(status 0)
set(found "FrontISTR Completed !!")
set(absent "")
if(CASE STREQUAL "data_line")
  set(analysis "*BOUNDARY\nFIX, 1, 3\n*STEP\n*STATIC\n*CLOAD\nTIP, 3, -1\n** a comment\nTIP, 3, bad\n*END STEP\n")
  math(EXPR line "${n} + 8")
  set(status 2)
  set(found "line:${line}, column:3")
elseif(CASE STREQUAL "solver_twice")
  string(APPEND analysis "*SOLVER, METHOD=DIRECTmf\n*SOLVER, METHOD=CG\n")
  set(status 2)
  set(found "*SOLVER exists twice")
elseif(CASE STREQUAL "parameters")
  set(analysis "*AMPLITUDE, NAME=RAMP\n0, 1, 1, 1\n*bOuNdArY, aMpLiTuDe = RAMP, OP=NEW\nFIX, 1, 3\n")
  string(APPEND analysis "*sTeP, name=Step-1, nLgEoM = no, INC=100\n*Static,\n** a parameter on a continuation line\n\n")
  string(APPEND analysis "\tSTABILIZE\n*CLOAD, AMPLITUDE=RAMP, FOLLOWER\nTIP, 3, -1\n*END STEP, UNUSED\n")
  foreach(warning "*STEP 5 NAME" "*STATIC 6 STABILIZE" "*CLOAD 10 FOLLOWER" "*END STEP 12 UNUSED")
    string(REGEX MATCH "^(.*) ([0-9]+) (.*)$" warning "${warning}")
    math(EXPR line "${n} + ${CMAKE_MATCH_2}")
    list(APPEND found "${CMAKE_MATCH_1} (line:${line}) : unsupported parameter ${CMAKE_MATCH_3} is skipped")
  endforeach()
  set(absent "parameter NLGEOM" "parameter AMPLITUDE" "parameter INC" "parameter OP")
elseif(CASE STREQUAL "step_warnings")
  set(analysis "*BOUNDARY\nFIX, 1, 3\n*TIME POINTS, NAME=T1\n0.5, 1.0\n*STEP, NLGEOM\n*STATIC, TIME RESET\n0.5, 1.0\n")
  string(APPEND analysis "*CONTROLS, PARAMETERS=TIME INCREMENTATION\n4, 8\n*CLOAD\nTIP, 3, -1\n*END STEP\n")
  string(APPEND analysis "*STEP, NLGEOM=NO\n*STATIC\n*CLOAD, OP=NEW\nTIP, 3, -0.5\n*END STEP\n")
  foreach(warning "*TIME POINTS 3 is skipped" "*STATIC 6 : unsupported parameter TIME RESET is skipped"
      "*CONTROLS 8 is skipped" "*STEP 13 : NLGEOM=NO is not used, since NLGEOM of an earlier step stays")
    string(REGEX MATCH "^(\\*[A-Z ]+) ([0-9]+) (.*)$" warning "${warning}")
    math(EXPR line "${n} + ${CMAKE_MATCH_2}")
    list(APPEND found "Warning: ${CMAKE_MATCH_1} (line:${line}) ${CMAKE_MATCH_3}")
  endforeach()
elseif(CASE STREQUAL "nonlinear_solver")
  # the line search of the quasi-Newton method writes aWolfe
  set(analysis "*NONLINEAR_SOLVER, METHOD=QUASINEWTON\n*BOUNDARY\nFIX, 1, 3\n*STEP, NLGEOM\n*STATIC\n*CLOAD\n")
  string(APPEND analysis "TIP, 3, -0.01\n*END STEP\n")
  list(APPEND found "aWolfe:")
elseif(CASE STREQUAL "step_amplitude")
  set(analysis "*AMPLITUDE, NAME=RAMP\n0, 0, 1, 1\n*BOUNDARY\nFIX, 1, 3\n*STEP\n*STATIC\n*CLOAD, AMPLITUDE=RAMP\n")
  string(APPEND analysis "TIP, 3, -1\n*END STEP\n*STEP\n*STATIC\n*END STEP\n")
  math(EXPR line "${n} + 10")
  set(status 2)
  set(found "*STEP (line:${line}) : AMPLITUDE= of a condition with more than one step is not supported yet")
elseif(CASE STREQUAL "time_delay")
  set(analysis "*AMPLITUDE, NAME=RAMP\n0, 0, 1, 1\n*BOUNDARY\nFIX, 1, 3\n*STEP\n*STATIC\n")
  string(APPEND analysis "*CLOAD, AMPLITUDE=RAMP, TIME DELAY=0.5\nTIP, 3, -1\n*END STEP\n")
  math(EXPR line "${n} + 7")
  set(status 2)
  set(found "*CLOAD (line:${line}) : TIME DELAY is not supported yet")
elseif(CASE STREQUAL "nlgeom_later")
  string(APPEND analysis "*STEP, NLGEOM\n*STATIC\n*END STEP\n")
  math(EXPR line "${n} + 8")
  set(status 2)
  set(found "*STEP (line:${line}) : NLGEOM given first in a later step is not supported yet")
elseif(CASE STREQUAL "load_overlap")
  # node 21 is a node of TIP
  string(APPEND analysis "*STEP\n*STATIC\n*CLOAD\n21, 3, -2\n*END STEP\n")
  set(status 2)
  set(found "*CLOAD : a load of step 2 is given to some nodes of a load of an earlier step given to another node set")
elseif(CASE STREQUAL "load_cancelled")
  # the loads of TIP sum to zero in step 2 up to a round-off, so node 21 of TIP takes another load in step 3
  set(analysis "*BOUNDARY\nFIX, 1, 3\n*STEP\n*STATIC\n*CLOAD\nTIP, 3, 0.2\n*END STEP\n")
  string(APPEND analysis "*STEP\n*STATIC\n*CLOAD\nTIP, 3, 0.1\nTIP, 3, -0.1\n*END STEP\n")
  string(APPEND analysis "*STEP\n*STATIC\n*CLOAD\n21, 3, -1\n*END STEP\n")
  set(absent "not supported")
elseif(CASE STREQUAL "op_new_later")
  # OP of the first card of a step is used for the step
  string(APPEND analysis "*STEP\n*STATIC\n*CLOAD\nTIP, 2, 0.5\n*CLOAD, OP=NEW\nTIP, 1, 0.1\n")
  string(APPEND analysis "*BOUNDARY\nFIX, 1, 3\n*BOUNDARY, OP=NEW\nFIX, 1, 3\n*END STEP\n")
  foreach(warning "*CLOAD 12" "*BOUNDARY 16")
    string(REGEX MATCH "^(.*) ([0-9]+)$" warning "${warning}")
    math(EXPR line "${n} + ${CMAKE_MATCH_2}")
    list(APPEND found "Warning: ${CMAKE_MATCH_1} (line:${line}) : OP=NEW is not used, since OP of the first ${CMAKE_MATCH_1} of a step is used")
  endforeach()
elseif(CASE STREQUAL "static_missing")
  string(APPEND analysis "*STEP\n*CLOAD\nTIP, 3, -2\n*END STEP\n")
  set(status 2)
  set(found "*STEP : each step needs one analysis card")
elseif(CASE STREQUAL "unknown_card")
  string(APPEND analysis "*DLOAD\n1, P1, 1\n")
  math(EXPR line "${n} + 8")
  set(status 2)
  set(found "*DLOAD (line:${line}) : not supported in an inp file yet")
elseif(CASE STREQUAL "static_frequency")
  set(analysis "*BOUNDARY\nFIX, 1, 3\n*STEP\n*STATIC\n*CLOAD\nTIP, 3, -1\n*FREQUENCY\n5\n*END STEP\n")
  math(EXPR line "${n} + 7")
  set(status 2)
  set(found "*FREQUENCY (line:${line}) : only one analysis card is allowed in a step")
elseif(CASE STREQUAL "frequency_static")
  set(analysis "*BOUNDARY\nFIX, 1, 3\n*STEP\n*FREQUENCY\n5\n*STATIC\n*CLOAD\nTIP, 3, -1\n*END STEP\n")
  math(EXPR line "${n} + 6")
  set(status 2)
  set(found "*STATIC (line:${line}) : only one analysis card is allowed in a step")
elseif(CASE STREQUAL "frequency_matrixstorage")
  set(analysis "*BOUNDARY\nFIX, 1, 3\n*STEP\n*FREQUENCY, SOLVER=MATRIXSTORAGE\n5\n*END STEP\n")
  math(EXPR line "${n} + 4")
  set(status 2)
  set(found "*FREQUENCY (line:${line}) : SOLVER=MATRIXSTORAGE is not supported")
elseif(CASE STREQUAL "frequency_no_data")
  set(analysis "*BOUNDARY\nFIX, 1, 3\n*STEP\n*FREQUENCY\n*END STEP\n")
  math(EXPR line "${n} + 4")
  set(status 2)
  set(found "line:${line}, column:-1 : data must exist")
elseif(CASE STREQUAL "frequency_zero")
  set(analysis "*BOUNDARY\nFIX, 1, 3\n*STEP\n*FREQUENCY\n0\n*END STEP\n")
  math(EXPR line "${n} + 4")
  set(status 2)
  set(found "*FREQUENCY (line:${line}) : the number of eigenfrequencies must be positive")
else()
  message(FATAL_ERROR "Unknown case: ${CASE}")
endif()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
file(WRITE "${WORK_DIR}/model.inp" "${mesh}${analysis}")
file(WRITE "${WORK_DIR}/hecmw_ctrl.dat"
  "!MESH, NAME=fstrMSH, TYPE=INP\nmodel.inp\n!CONTROL, NAME=fstrCNT\nmodel.inp\n!RESULT, NAME=fstrRES, IO=OUT\nmodel.res\n")
execute_process(COMMAND "${PROGRAM}" -t 1 WORKING_DIRECTORY "${WORK_DIR}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
set(log "${output}${errors}")
if(EXISTS "${WORK_DIR}/0.log")
  file(READ "${WORK_DIR}/0.log" rank0)
  string(APPEND log "${rank0}")
endif()
file(WRITE "${WORK_DIR}/solver.log" "${log}")
if(NOT "${result}" STREQUAL "${status}")
  message(FATAL_ERROR "${CASE}: exit status ${result}, expected ${status}; see ${WORK_DIR}/solver.log")
endif()
foreach(text IN LISTS found)
  string(FIND "${log}" "${text}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "${CASE}: '${text}' not found; see ${WORK_DIR}/solver.log")
  endif()
endforeach()
foreach(text IN LISTS absent)
  string(FIND "${log}" "${text}" position)
  if(NOT position EQUAL -1)
    message(FATAL_ERROR "${CASE}: unexpected '${text}'; see ${WORK_DIR}/solver.log")
  endif()
endforeach()
