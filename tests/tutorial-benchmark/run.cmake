file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/failure.log" "")
file(GLOB meshes "${INPUT}/*.msh")
list(LENGTH meshes count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Expected one mesh in ${INPUT}")
endif()
list(GET meshes 0 mesh_path)
get_filename_component(mesh "${mesh_path}" NAME)
get_filename_component(stem "${mesh_path}" NAME_WE)
configure_file("${mesh_path}" "${WORK}/${mesh}" COPYONLY)
file(READ "${INPUT}/${stem}.cnt" control)
if(NOT "${SOLVER_OVERRIDE}" STREQUAL "")
  string(REGEX REPLACE "!SOLVER[^\n\r]*" "!SOLVER,METHOD=${SOLVER_OVERRIDE}" control "${control}")
endif()
if(NOT "${SOLVER_PARAMETERS}" STREQUAL "")
  string(REGEX REPLACE "(!SOLVER[^\n\r]*)[\r\n]+[^!#]*" "\\1\n${SOLVER_PARAMETERS}\n" control "${control}")
endif()
string(REGEX REPLACE "(^|\n)![Oo][Uu][Tt][Pp][Uu][Tt]_[Tt][Yy][Pp][Ee][ \t]*=[^\n\r]*" "\\1!OUTPUT_TYPE=${OUTPUT_TYPE}" control "${control}")
file(WRITE "${WORK}/${stem}.cnt" "${control}")
set(mesh_type HECMW-ENTIRE)
if(NP GREATER 1)
  set(mesh_type HECMW-DIST)
endif()
file(WRITE "${WORK}/hecmw_ctrl.dat"
  "!MESH,NAME=fstrMSH,TYPE=${mesh_type}\n${mesh}\n!CONTROL,NAME=fstrCNT\n${stem}.cnt\n!RESULT,NAME=fstrRES,IO=OUT\n${stem}.res\n!RESULT,NAME=vis_out,IO=OUT\n${stem}_vis\n!MESH,NAME=part_in,TYPE=HECMW-ENTIRE\n${mesh}\n!MESH,NAME=part_out,TYPE=HECMW-DIST\n${mesh}\n")
set(ENV{OMP_NUM_THREADS} "${NT}")
set(ENV{OMPI_ALLOW_RUN_AS_ROOT} 1)
set(ENV{OMPI_ALLOW_RUN_AS_ROOT_CONFIRM} 1)
set(ENV{OMPI_MCA_btl_sm_backing_directory} /tmp)
if(NP GREATER 1)
  file(WRITE "${WORK}/hecmw_part_ctrl.dat"
    "!PARTITION,TYPE=NODE-BASED,METHOD=KMETIS,DOMAIN=${NP},DEPTH=1\n")
  execute_process(COMMAND "${MPIEXEC}" -n 1 "${PARTITIONER}"
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status
    OUTPUT_FILE "${WORK}/partition.log" ERROR_FILE "${WORK}/partition.log" TIMEOUT 180)
  file(READ "${WORK}/partition.log" log)
  if(NOT status STREQUAL "0" OR NOT log MATCHES "Domain decomposition done")
    file(WRITE "${WORK}/failure.log" "Partitioning failed: ${status}\n${log}")
    message(FATAL_ERROR "Partitioning failed: ${status}\n${log}")
  endif()
  set(launcher "${MPIEXEC}" -n "${NP}")
endif()
execute_process(COMMAND ${launcher} "${SOLVER}" -t "${NT}"
  WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status
  OUTPUT_FILE "${WORK}/solver.log" ERROR_FILE "${WORK}/solver.log" TIMEOUT 180)
file(READ "${WORK}/solver.log" log)
if(NOT status STREQUAL "0" OR NOT log MATCHES "FrontISTR Completed !!"
    OR log MATCHES "Fail to Converge")
  file(WRITE "${WORK}/failure.log" "Solver failed: ${status}\n${log}")
  message(FATAL_ERROR "Solver failed: ${status}\n${log}")
endif()
message(STATUS "Completed ${stem}; log: ${WORK}/solver.log")
