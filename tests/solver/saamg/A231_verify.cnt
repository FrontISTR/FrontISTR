!!
!! SA-AMG (PRECOND=22) test : the setup self-checks SA_Verify=1 (real slot7) on the NDOF=2 plane model of A231
!! the near-kernel of the checks must follow NDOF (2 translations, 1 rotation); all check lines must be printed
!! coarsest solver forced to dense LDL^T (coarse_solver=2 (int slot1)) -> no external library dependency
!!
!BOUNDARY
  FIX, 1, 2,  0.0
!CLOAD
  CL1, 2, -1.0
!SOLVER,METHOD=CG,PRECOND=22,ITERLOG=NO,TIMELOG=NO
 10000, 1
 1.0e-8, 1.0, 0.0
 2
 0, 0, 0, 0, 0, 0, 1
!WRITE,RESULT
!END
