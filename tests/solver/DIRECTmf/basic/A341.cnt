!! Multifrontal direct solver (METHOD=DIRECTmf): checks that the symbolic factorization self
!! check and the comparison with the built-in DIRECT report no violation (LOGLEVEL=2) and
!! that the solution of the multifrontal LDLt matches the reference computed by DIRECT.
!BOUNDARY
  FIX, 1, 3,   0.0
!CLOAD
  CL1,    3,  -1.0
!!
!! SOLVER CONTROL
!!
!SOLVER,METHOD=DIRECTmf,ITERLOG=YES,TIMELOG=YES,LOGLEVEL=2
 10000, 1
 1.0e-8, 1.0, 0.0
!WRITE,RESULT
!END
