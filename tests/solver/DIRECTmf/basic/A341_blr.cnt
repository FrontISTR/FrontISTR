!! Multifrontal direct solver with BLR compression (METHOD=DIRECTmf, option line BLR=1):
!! checks that the option lines are read, the compressed factorization with the default
!! epsilon plus iterative refinement reproduces the reference computed by DIRECT.
!BOUNDARY
  FIX, 1, 3,   0.0
!CLOAD
  CL1,    3,  -1.0
!!
!! SOLVER CONTROL
!!
!SOLVER,METHOD=DIRECTmf,ITERLOG=YES,TIMELOG=YES,LOGLEVEL=1
 10000, 1
 1.0e-8, 1.0, 0.0
 0, 0, 1
!WRITE,RESULT
!END
