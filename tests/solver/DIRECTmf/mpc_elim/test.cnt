!! Multifrontal direct solver (METHOD=DIRECTmf) with the MPC equations handled by the
!! elimination method (MPCMETHOD=3). The mesh and the reference are shared byte for byte
!! with tests/with_mumps/mpc_elim_mumps.
!VERSION
 3
!SOLUTION, TYPE=STATIC
!STATIC
##
## fix
##
!BOUNDARY, GRPID=1
 bottom, 1, 3, 0.0
#    top, 1, 2, 1.0
    top, 3, 3,-1.0
##
## non-linear
##
!MATERIAL, NAME=M00001
!ELASTIC, INFINITESIMAL
 2.613E+04, 0.2
#!PLASTIC, YIELD=MISES, HARDEN=BILINEAR, INFINITE
# 1.0e+99, 1.0
!SECTION, SECNUM=1, FORM361=FI
##
## step
##
#!STEP, TYPE=STATIC, SUBSTEPS=10, CONVERG=1.0E-03, MAXITER=200
# 0.1, 1.0
!STEP, TYPE=STATIC, SUBSTEPS=1
 BOUNDARY, 1
!!
!! SOLVER CONTROL
!!
!SOLVER, METHOD=DIRECTmf, PRECOND=3, ITERLOG=YES, TIMELOG=YES, MPCMETHOD=3
 30, 1
 1.0e-8, 1.0, 0.0
!!
!! POST CONTROL
!!
!WRITE,RESULT
!WRITE,VISUAL, FREQUENCY=100
!VISUAL, method=PSR
!surface_num = 1
!surface 1
!surface_style = 1
!group_name = boundary
!display_method  1
!color_comp_name   =  STRESS
!color_subcomp         7
!output_type  = VTK
!END
