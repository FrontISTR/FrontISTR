!!
!! Two cantilever shell plates of different thickness share one material.
!! The mass matrix has to be built with the thickness of each section.
!!
!SOLUTION, TYPE=EIGEN
!EIGEN
 6, 1.0E-8, 60
!BOUNDARY
  FIX, 1, 6, 0.0
!SOLVER,METHOD=CG,PRECOND=3,ITERLOG=NO,TIMELOG=NO
 10000, 1
 1.0e-8, 1.0, 0.0
!WRITE,RESULT
!END
