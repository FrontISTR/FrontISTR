#  heat conduction with !SFLUX, !SFILM and !SRADIATE given to surface groups
!VERSION
 3
!SOLVER,METHOD=CG,PRECOND=1,ITERLOG=NO,TIMELOG=NO
 50000, 1
 1.0e-10, 1.0, 0.0
!SOLUTION, TYPE=HEAT
!HEAT
  1.0, 10.0, 0.0, 20.0, 100, 1.0E-3
!WRITE,RESULT, FREQUENCY=5
!OUTPUT_RES
 TEMP, ON
!ORIENTATION, DEFINITION=COORDINATES, NAME=R0
 1,0,0, 0,1,0, 0,0,0
!SECTION, SECNUM=1 ,ORIENTATION=R0
!INITIAL_CONDITION, TYPE=TEMPERATURE
 NALL,  200.0
!SFILM, AMP2=AMP2
 SA, 5.0E-06, 1.0
!SFILM, AMP2=AMP3
 SB, 5.0E-06, 1.0
!SFLUX, AMP=AMP0
 SA, 1.0E-03
 SB, 2.0E-03
!SRADIATE, AMP2=AMP3
 SB, 1.0E-14, 1.0
!SRADIATE
 SA, 2.0E-14, 250.0
!END
