*SOLID SECTION, ELSET=EA, MATERIAL=M
*BOUNDARY
FIX, 1, 3
*STEP
*STATIC
*DLOAD
EA, P2, 0.1
*END STEP
*STEP
*STATIC
*DSLOAD
STOP, P, 0.2
*DLOAD
EA, GRAV, 10.0, 0.0, 0.0, -1.0
*END STEP
*STEP
*STATIC
*DLOAD, OP=NEW
4, P4, 0.2
EA, P2, 0.05
*END STEP
