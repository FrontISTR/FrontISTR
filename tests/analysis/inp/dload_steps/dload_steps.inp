*ELEMENT, TYPE=C3D8, ELSET=EA
1, 1, 2, 7, 6, 11, 12, 17, 16
2, 2, 3, 8, 7, 12, 13, 18, 17
3, 3, 4, 9, 8, 13, 14, 19, 18
4, 4, 5, 10, 9, 14, 15, 20, 19
*NSET, NSET=FIX
1, 6, 11, 16
*SURFACE, NAME=STOP
EA, S2
*MATERIAL, NAME=M
*ELASTIC
1000.0, 0.3
*DENSITY
