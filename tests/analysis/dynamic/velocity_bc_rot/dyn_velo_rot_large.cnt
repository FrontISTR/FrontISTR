########################################################
## Dynamic implicit analysis (NONLINEAR): rotational
##   velocity BC with a large rotation per increment.
##   wz(t) = 10 * amp(t), amp: 0 -> 1 linear over [0,0.5],
##   dt = 0.01 (wz*dt up to 0.1 rad), 50 increments.
##   Imposed on all nodes via
##   !VELOCITY, AMP=AMP_SPIN, ROT_CENTER=CENTER.
##   Check: the distance from the z-axis is kept and
##   |v(t)| = wz(t) * (distance from z-axis).
########################################################
!VERSION
 3
!SOLUTION, TYPE=DYNAMIC, NONLINEAR
!DYNAMIC
 1 , 1
 0.0, 0.5, 50, 0.01
 0.5, 0.25
 1, 1, 0.0, 0.0
 100, 1, 100
 1, 1, 1, 1, 1, 1
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!VELOCITY, TYPE=TRANSIT, AMP=AMP_SPIN, ROT_CENTER=CENTER
 ALLN, 1, 1, 0.0
 ALLN, 2, 2, 0.0
 ALLN, 3, 3, 10.0
###################################
#####         MATERIAL        #####
###################################
!MATERIAL, NAME=MAT1
!ELASTIC
 1.00000000E+02, 3.00000000E-01
!DENSITY
 1.00000000E-03
###################################
#####       SOLVER CONTROL    #####
###################################
!SOLVER,METHOD=CG,PRECOND=1,ITERLOG=NO,TIMELOG=NO
 500000, 2
 1.00e-08, 1.00, 0.0
!STEP, SUBSTEPS=100
0.01, 0.5, 1.0E-4, 0.01
BOUNDARY, 1
!WRITE,RESULT,FREQUENCY=25
!OUTPUT_RES
 DISP,ON
 VEL,ON
 ACC,ON
!END
