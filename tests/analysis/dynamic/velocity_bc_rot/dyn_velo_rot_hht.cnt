########################################################
## Dynamic implicit analysis (NONLINEAR, HHT method):
##   rotational velocity BC with gamma > 1/2.
##   alpha = -0.2 gives gamma = 0.7 and beta = 0.36 (the
##   0.5, 0.25 given with alpha are not used), so the
##   acceleration at the start of each increment enters
##   the end position with dt^2*(gamma-2*beta)/(2*gamma).
##   wz(t) = 10 * amp(t), amp: 0 -> 1 linear over [0,0.5]
##   and 1 over [0.5,1.0], dt = 0.01, 100 increments.
##   Imposed on all nodes via
##   !VELOCITY, AMP=AMP_SPIN, ROT_CENTER=CENTER.
##   Check: |v(t)| = wz(t) * (distance from z-axis); the
##   distance shrinks slowly while wz is constant
##   (relative 1e-5 over [0.5,1.0]).
########################################################
!VERSION
 3
!SOLUTION, TYPE=DYNAMIC, NONLINEAR
!DYNAMIC
 2 , 1
 0.0, 1.0, 100, 0.01
 0.5, 0.25, -0.2
 1, 1, 0.0, 0.0
 100, 1, 100
 1, 1, 1, 1, 1, 1
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!VELOCITY, TYPE=TRANSIT, AMP=AMP_SPIN, ROT_CENTER=CENTER
 ALLN, 1, 1, 0.0
 ALLN, 2, 2, 0.0
 ALLN, 3, 3, 10.0
###################################
#####         MATERIAL        #####
###################################
!MATERIAL, NAME=MAT1
!ELASTIC
 1.00000000E+02, 3.00000000E-01
!DENSITY
 1.00000000E-03
###################################
#####       SOLVER CONTROL    #####
###################################
!SOLVER,METHOD=CG,PRECOND=1,ITERLOG=NO,TIMELOG=NO
 500000, 2
 1.00e-08, 1.00, 0.0
!STEP, SUBSTEPS=200
0.01, 1.0, 1.0E-4, 0.01
BOUNDARY, 1
!WRITE,RESULT,FREQUENCY=50
!OUTPUT_RES
 DISP,ON
 VEL,ON
 ACC,ON
!END
