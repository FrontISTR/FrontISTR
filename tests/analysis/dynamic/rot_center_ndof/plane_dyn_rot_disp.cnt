########################################################
## Rotational displacement BC on 241 plane elements (NDOF=2), implicit
##   Two separate plates are rotated about the z-axis
##   through node 1 (!BOUNDARY, ROT_CENTER=CENTER); the
##   angle grows linearly to 0.1 rad at t = 1.0.
##   Check: u = R(theta(t))*(x - x_c) - (x - x_c).
########################################################
!VERSION
 3
!SOLUTION, TYPE=DYNAMIC
!DYNAMIC
 1 , 1
 0.0, 1.0, 10, 0.1
 0.5, 0.25
 1, 1, 0.0, 0.0
 100, 1, 100
 1, 1, 1, 1, 0, 0
!AMPLITUDE, NAME=RAMP
 0.0, 0.0, 1.0, 1.0
!BOUNDARY, ROT_CENTER=CENTER, GRPID=1, AMP=RAMP
 ALLN, 3, 3, 0.1
!MATERIAL, NAME=MAT1
!ELASTIC
 1.00000000E+02, 3.00000000E-01
!DENSITY
 1.00000000E-03
!SOLVER,METHOD=CG,PRECOND=1,ITERLOG=NO,TIMELOG=NO
 500000, 2
 1.00e-08, 1.00, 0.0
!STEP, SUBSTEPS=10
0.1, 1.0, 1.0E-3, 0.1
BOUNDARY, 1
!WRITE,RESULT,FREQUENCY=5
!OUTPUT_RES
 DISP,ON
!END
