########################################################
## Torque load on 741 shells (NDOF=6), implicit dynamic
##   Two separate plates, each fixed at its x = 0 edge.
##   Torque 1.0e-3 about the z-axis through node 1 is
##   applied to the nodes at x = 2 (!CLOAD, ROT_CENTER).
##   The forces go to dof 1-3 only.
########################################################
!VERSION
 3
!SOLUTION, TYPE=DYNAMIC
!DYNAMIC
 1 , 1
 0.0, 1.0, 10, 0.1
 0.5, 0.25
 1, 1, 0.0, 0.0
 100, 1, 100
 1, 1, 1, 1, 0, 0
!BOUNDARY, GRPID=1
 FIX, 1, 6, 0.0
!CLOAD, ROT_CENTER=CENTER, GRPID=1
 TIP, 3, 1.0E-3
!MATERIAL, NAME=MAT1
!ELASTIC
 1.00000000E+02, 3.00000000E-01
!DENSITY
 1.00000000E-03
!SOLVER,METHOD=CG,PRECOND=1,ITERLOG=NO,TIMELOG=NO
 500000, 2
 1.00e-08, 1.00, 0.0
!STEP, SUBSTEPS=10
0.1, 1.0, 1.0E-3, 0.1
BOUNDARY, 1
LOAD, 1
!WRITE,RESULT,FREQUENCY=5
!OUTPUT_RES
 DISP,ON
!END
