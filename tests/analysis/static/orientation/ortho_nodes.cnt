####################################################################
## !ORIENTATION, DEFINITION=NODES with the third node omitted     ##
## Orthotropic solid. The local system is built from node 6,      ##
## node 5 and the global origin (third node omitted), which gives ##
## local x = (1,0,1)/sqrt(2), y = (0,1,0), z = (-1,0,1)/sqrt(2).  ##
## Both nodes belong to both elements, so the definition also     ##
## works on a partitioned mesh.                                   ##
####################################################################
###################################
#####   SOLVER INFORMATION    #####
###################################
!VERSION
 3
!SOLUTION, TYPE=STATIC, NONLINEAR
!WRITE,LOG
!WRITE,RESULT,FREQUENCY=2
!SOLVER,METHOD=CG,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-06, 1.00, 0.0
 0.100, 0.100
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!BOUNDARY, GRPID=1
 FIX,1,1
 FIX,2,2
 FIX,3,3
!CLOAD, GRPID=1
 LOAD,2,-1.
###################################
#####         MATERIAL        #####
###################################
!ORIENTATION, NAME=ORI_NODES, DEFINITION=NODES
6, 5
!SECTION, SECNUM=1, ORIENTATION=ORI_NODES, FORM361=BBAR
!MATERIAL, NAME=MATERIAL1
!ELASTIC,  TYPE=ORTHOTROPIC
 1.00000000E+03, 5.00000000E+02, 1.00000000E+02, 3.00000000E-01, 2.00000000E-01, 1.00000000E-01, 3.00000000E+03, 1.50000000E+03, 3.00000000E+02
###################################
#####       STEP CONTROL      #####
###################################
!STEP, SUBSTEPS=2, CONVERG=1.000E-07
BOUNDARY,1
LOAD,1
!END
