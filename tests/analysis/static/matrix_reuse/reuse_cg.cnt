!VERSION
 5
!SOLUTION, TYPE=STATIC
# Three load cases on the same constraints. Steps 2 and 3 keep the factorized
# stiffness matrix (or preconditioner) of step 1 (MATRIX=REUSE). The reference
# results were produced by the same input without MATRIX=REUSE.
!BOUNDARY, GRPID=1
 FIX, 1, 3, 0.0
!CLOAD, GRPID=11
 CL1, 3, -1.0
!CLOAD, GRPID=12
 CL2, 3, -1.0
!CLOAD, GRPID=13
 CL3, 2, -1.0
!STEP
 BOUNDARY, 1
 LOAD, 11
!STEP, MATRIX=REUSE
 BOUNDARY, 1
 LOAD, 12
!STEP, MATRIX=REUSE
 BOUNDARY, 1
 LOAD, 13
!SOLVER, METHOD=CG, PRECOND=3, ITERLOG=NO, TIMELOG=YES
 10000, 1
 1.0e-10, 1.0, 0.0
!WRITE, RESULT, FREQUENCY=1
!OUTPUT_RES
 DISP, ON
 NSTRESS, ON
!END
