########################################################
## Torque load on 741 shells (NDOF=6)
##   Two separate plates, each fixed at its x = 0 edge.
##   Torque 1.0 about the z-axis through node 1 is applied
##   to the nodes at x = 2 (!CLOAD, ROT_CENTER=CENTER).
##   Check: each of the n torque nodes gets the force
##   (T/n) (e_z x r)/|e_z x r|^2 on dof 1-3 only, so the
##   reactions balance the force and the moment T.
########################################################
!VERSION
 3
!SOLUTION, TYPE=STATIC
!BOUNDARY, GRPID=1
 FIX, 1, 6, 0.0
!CLOAD, ROT_CENTER=CENTER, GRPID=1
 TIP, 3, 1.0
!MATERIAL, NAME=MAT1
!ELASTIC
 1.00000000E+02, 3.00000000E-01
!SOLVER,METHOD=CG,PRECOND=1,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.00e-08, 1.00, 0.0
!STEP
BOUNDARY,1
LOAD,1
!WRITE,RESULT
!OUTPUT_RES
 DISP,ON
 REACTION,ON
!END
