########################################################
## Rotational displacement BC on 241 plane elements (NDOF=2)
##   Two separate plates are rotated by 0.1 rad about the
##   z-axis through node 1 (!BOUNDARY, ROT_CENTER=CENTER).
##   In 2D only the rotation about the z-axis (dof 3 or 6)
##   can be given.
##   Check: u = R*(x - x_c) - (x - x_c) for all nodes.
########################################################
!VERSION
 3
!SOLUTION, TYPE=STATIC
!BOUNDARY, ROT_CENTER=CENTER, GRPID=1
 ALLN, 3, 3, 0.1
!MATERIAL, NAME=MAT1
!ELASTIC
 1.00000000E+02, 3.00000000E-01
!SOLVER,METHOD=CG,PRECOND=1,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.00e-08, 1.00, 0.0
!STEP, SUBSTEPS=1
BOUNDARY,1
!WRITE,RESULT
!OUTPUT_RES
 DISP,ON
!END
