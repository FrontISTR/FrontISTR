###############################################
## Reduced integration of the hexahedra, mixed with full integration.
## Three cantilevers of 1x1 section, the root half FI and the tip half RI:
## 4x1x1 elements 361 of an elastic material (total Lagrangian), the mesh warped,
## 2x2x2 elements 362 of the same material, and 4x1x1 warped elements 361 of
## an elastoplastic material (updated Lagrangian) under tension and bending, which
## yields in step 1. The tips carry a load that is doubled in step 2.
## Restart run: step 2 only (reads the restart of step 1, which holds the rule of each element)
###############################################
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!RESTART, FREQUENCY=-2
!SECTION, SECNUM=1, FORM361=FI
!SECTION, SECNUM=2, FORM361=RI
!SECTION, SECNUM=3, FORM362=FI
!SECTION, SECNUM=4, FORM362=RI
!SECTION, SECNUM=5, FORM361=FI
!SECTION, SECNUM=6, FORM361=RI
!MATERIAL, NAME=M1
!ELASTIC
 1000.0, 0.3
!MATERIAL, NAME=M2
!ELASTIC, CAUCHY
 1000.0, 0.3
!PLASTIC, YIELD=MISES, HARDEN=BILINEAR
 1.0, 50.0
!BOUNDARY, GRPID=1
 FIX, 1, 3, 0.0
!CLOAD, GRPID=2
 TIP_H8, 3, 0.5
 TIP_H20, 3, 0.4
 TIP_PL, 1, 0.6
 TIP_PL, 3, 0.03
!SOLVER, METHOD=CG, PRECOND=1, ITERLOG=NO, TIMELOG=NO
 10000, 2
 1.0e-8, 1.0, 0.0
!STEP, SUBSTEPS=2
 BOUNDARY, 1
 LOAD, 2
!WRITE, RESULT, FREQUENCY=2
!OUTPUT_RES
 NSTRESS, ON
 ISTRESS, ON
 PL_ISTRAIN, ON
 REACTION, ON
!END
