###############################################
## Reduced integration of the plane elements, mixed with full integration.
## A cantilever of 8x2 elements 241 in plane stress, the root half FI and the tip
## half RI with hourglass control, and one of 4x1 elements 242 in plane strain,
## the root half FI (3x3 points) and the tip half RI (2x2 points).
## The 241 mesh is warped. Both tips carry a lateral load that is doubled in step 2.
## Half run: step 1 only (writes the restart at the end of step 1)
###############################################
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!RESTART, FREQUENCY=2
!SECTION, SECNUM=1, FORM241=FI
!SECTION, SECNUM=2, FORM241=RI
!SECTION, SECNUM=3, FORM242=FI
!SECTION, SECNUM=4, FORM242=RI
!MATERIAL, NAME=M1
!ELASTIC, INFINITESIMAL
 1000.0, 0.3
!BOUNDARY, GRPID=1
 FIX, 1, 2, 0.0
!CLOAD, GRPID=1
 TIP_Q4, 2, 0.01
 TIP_Q8, 2, 0.01
!SOLVER, METHOD=CG, PRECOND=1, ITERLOG=NO, TIMELOG=NO
 10000, 2
 1.0e-8, 1.0, 0.0
!STEP, SUBSTEPS=2
 BOUNDARY, 1
 LOAD, 1
!WRITE, RESULT, FREQUENCY=2
!OUTPUT_RES
 NSTRESS, ON
 ISTRESS, ON
 REACTION, ON
!END
