# FOLLOW=NO of !DLOAD in a geometrically nonlinear analysis: both pressures are applied as
# non-follower loads.
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!BOUNDARY, GRPID=1
 FIX, 1, 3, 0.0
!DLOAD, GRPID=1, FOLLOW=NO
 E1, P2, 5000.0
 E1, P3, 5000.0
!STEP, SUBSTEPS=4, CONVERG=1.0E-8
 BOUNDARY, 1
 LOAD, 1
!MATERIAL, NAME=M1
!ELASTIC
 1.0E+05, 0.3
!SOLVER, METHOD=CG, PRECOND=1, ITERLOG=NO, TIMELOG=NO
 10000, 1
 1.0E-8, 1.0, 0.0
!WRITE, RESULT, FREQUENCY=4
!END
