# The load on the node 13, which belongs to no element, reaches the model through
# the equation u_z(13) = u_z(11): the result equals that of the load on the node 11
!VERSION
 3
!SOLUTION, TYPE=STATIC
!BOUNDARY
 FIX, 1, 3, 0.0
 13, 1, 2, 0.0
!CLOAD
 13, 3, -1.0
!SOLVER, METHOD=CG, PRECOND=1, ITERLOG=NO, TIMELOG=NO, MPCMETHOD=3
 10000, 1
 1.0e-12, 1.0, 0.0
!WRITE, RESULT
!END
