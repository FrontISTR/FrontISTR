# The load on the node group RP of the node 13, which belongs to no element, reaches the
# model through the equation u_z(RP) = u_z(TIP): the result equals that of the load on TIP
!VERSION
 3
!SOLUTION, TYPE=STATIC
!BOUNDARY
 FIX, 1, 3, 0.0
 RP, 1, 2, 0.0
!CLOAD
 RP, 3, -1.0
!SOLVER, METHOD=CG, PRECOND=1, ITERLOG=NO, TIMELOG=NO, MPCMETHOD=3
 10000, 1
 1.0e-12, 1.0, 0.0
!WRITE, RESULT
!END
