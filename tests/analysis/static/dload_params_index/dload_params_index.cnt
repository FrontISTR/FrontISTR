# PX, PY, and PZ in one DLOAD card must not replace the GRAV direction.
!BOUNDARY
  FIX, 1, 6, 0.0
!DLOAD
  ALL, GRAV, 9.8, 0.577350269189626, 0.577350269189626, -0.577350269189626
  ALL, PX, 0.0
  ALL, PY, 0.0
  ALL, PZ, 0.0
!SOLVER,METHOD=CG,PRECOND=3,ITERLOG=YES,TIMELOG=YES
  10000, 1
  1.0e-8, 1.0, 0.0
!WRITE,RESULT
!END
