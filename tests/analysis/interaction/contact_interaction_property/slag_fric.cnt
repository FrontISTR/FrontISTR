###################################################################################
##### contact_slag_iter/2box_hex_fric_iter with the friction coefficient and the
##### tangential penalty factor given by !INTERACTION_PROPERTY, !FRICTION and !PENALTY
##### instead of the data line of !CONTACT, leaving the normal penalty at its default.
##### The results are the same as those of 2box_hex_fric_iter.
###################################################################################
###################################
#####   SOLVER INFORMATION    #####
###################################
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!CONTACT_ALGO,TYPE=SLAGRANGE
!WRITE,RESULT,FREQUENCY=10
!OUTPUT_RES
DISP,ON
REACTION,ON
NSTRAIN,OFF
NSTRESS,ON
NMISES,ON
ESTRAIN,OFF
ESTRESS,ON
EMISES,ON
ISTRAIN,ON
ISTRESS,ON
CONTACT_NFORCE,ON
CONTACT_FRICTION,ON
CONTACT_RELVEL,ON
CONTACT_STATE,ON
CONTACT_FTRACTION,ON
CONTACT_NTRACTION,ON
!OUTPUT_VIS
DISP,ON
REACTION,ON
NSTRAIN,OFF
NSTRESS,ON
NMISES,ON
CONTACT_NFORCE,ON
CONTACT_FRICTION,ON
CONTACT_RELVEL,ON
CONTACT_STATE,ON
CONTACT_FTRACTION,ON
CONTACT_NTRACTION,ON
!WRITE,LOG
!SOLVER,METHOD=GMRES,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-06, 1.00, 0.0
 0.100, 0.100
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!BOUNDARY, GRPID=1
 SET_1,1,1
!BOUNDARY, GRPID=2
 SET_2,2,2
!BOUNDARY, GRPID=3
 SET_3,3,3
!BOUNDARY, GRPID=4
 SET_4,3,3,-0.1
###################################
#####   CONTACT DEFINITIONS   #####
###################################
!INTERACTION_PROPERTY, NAME=IP1
!FRICTION
 0.3
!PENALTY
 , 5.0E+2
!CONTACT, INTERACTION=FSLID, GRPID=1, INTERACTION_PROPERTY=IP1
CP1
###################################
#####         MATERIAL        #####
###################################
!MATERIAL, NAME=MATERIAL_1
!ELASTIC
 1.00000000E+03, 3.00000000E-01
###################################
#####       STEP CONTROL      #####
###################################
!STEP, SUBSTEPS=1, CONVERG=1.0e-6
BOUNDARY,1
BOUNDARY,2
BOUNDARY,3
BOUNDARY,4
CONTACT,1
###################################
#####      FOR VISUALIZER     #####
###################################
!WRITE,VISUAL,FREQUENCY=10
!VISUAL, method=PSR
!surface_num=1
!surface 1
!output_type = BIN_VTK
!END
