###################################################################################
##### !PENALTY, TYPE=ABSOLUTE in both directions with the augmented Lagrange method.
##### The upper of two stacked blocks is pressed by p = 1.0 and its top is moved along x
##### by 1.0E-3 (not loaded, so that the first iteration, whose friction has no stiffness
##### yet, is not singular). With AUGITER=1 and one substep the multipliers start from 0,
##### and after the one update the contact force of each slave node is K_N * A * g and
##### its friction force K_T * A * s, with K_N = 2.0E+3 and K_T = 20.0 per unit area,
##### A the share of the node in the slave surface, g its penetration and s its slip.
###################################################################################
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!CONTACT_ALGO, TYPE=ALAGRANGE, AUGITER=1
!WRITE,RESULT
!WRITE,LOG
!OUTPUT_RES
DISP,ON
REACTION,ON
CONTACT_NFORCE,ON
CONTACT_FRICTION,ON
CONTACT_STATE,ON
!SOLVER,METHOD=GMRES,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-10, 1.00, 0.0
 0.100, 0.100
!BOUNDARY, GRPID=1
 BOTTOM, 1, 3, 0.0
 UYSYM,  2, 2, 0.0
 TOPN,   1, 1, 1.0E-3
!DLOAD, GRPID=1
 TOP, S, 1.0
!INTERACTION_PROPERTY, NAME=IP1
!FRICTION
 0.3
!PENALTY, TYPE=ABSOLUTE
 2.0E+3, 2.0E+1
!CONTACT, GRPID=1, INTERACTION=SSLID, INTERACTION_PROPERTY=IP1
 CP1
!MATERIAL, NAME=MAT1
!ELASTIC
 1.0E+03, 0.0
!STEP, SUBSTEPS=1, MAXITER=20, CONVERG=1.0E-8
 BOUNDARY, 1
 LOAD, 1
 CONTACT, 1
!END
