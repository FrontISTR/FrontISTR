!!
!! The upper block is pressed onto the lower block (node-to-surface contact).
!! The cantilever beam is not connected to the blocks; it is converted to 641
!! with rotational dummy nodes when the mesh is read.
!! Tip of the beam: deflection PL^3/3EI = 0.02, rotation PL^2/2EI = 0.015
!!
!VERSION
 3
!SOLUTION, TYPE=STATIC
!CONTACT_ALGO, TYPE=SLAGRANGE
!MATERIAL, NAME=M_SOLID
!ELASTIC
 2.0E+05, 0.3
!MATERIAL, NAME=M_BEAM
!ELASTIC
 2.0E+05, 0.3
!BOUNDARY, GRPID=1
 L_BOT, 1, 3, 0.0
 U_TOP, 1, 2, 0.0
 B_FIX, 1, 6, 0.0
!BOUNDARY, GRPID=2
 U_TOP, 3, 3, -0.01
!CLOAD, GRPID=1
 B_TIP, 3, -0.015
!CONTACT, INTERACTION=FSLID, GRPID=1
 CP1, 0.0, 50.0
!STEP, SUBSTEPS=2
 BOUNDARY, 1
 BOUNDARY, 2
 LOAD, 1
 CONTACT, 1
!SOLVER, METHOD=CG, PRECOND=1, NSET=0, ITERLOG=NO, TIMELOG=NO
 5000, 1
 1.0E-08, 1.0, 0.0
!WRITE, RESULT, FREQUENCY=2
!OUTPUT_RES
 DISP, ON
 REACTION, ON
 NSTRESS, ON
 NMISES, ON
 ESTRESS, ON
 EMISES, ON
 CONTACT_NFORCE, ON
 CONTACT_STATE, ON
!END
