##############################################################
## Restart during the approach of a damped contact pair
## (issue #843), ALAGRANGE. Full run without restart.
## Step 1, 2: the top box approaches; every slave node stays
##            CONTACTNEAR (gap 0.012 -> 0.006, DAMP_GACT=0.02).
## Step 3   : the boxes come into contact.
## damp_near_restart_alag_half.cnt and _restart.cnt resume from
## the end of step 1; their step-3 results are compared with
## this run.
##############################################################
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!CONTACT_ALGO,TYPE=ALAGRANGE
!WRITE,RESULT,FREQUENCY=1
!OUTPUT_RES
DISP,ON
REACTION,ON
NSTRESS,ON
CONTACT_NFORCE,ON
CONTACT_STATE,ON
!WRITE,LOG
!SOLVER,METHOD=CG,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-08, 1.00, 0.0
 0.100, 0.100
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!BOUNDARY, GRPID=1
 SET_1,1,1
!BOUNDARY, GRPID=2
 SET_2,2,2
!BOUNDARY, GRPID=3
 SET_3,3,3
!BOUNDARY, GRPID=4
 SET_4,3,3,-0.003
!BOUNDARY, GRPID=5
 SET_4,3,3,-0.006
!BOUNDARY, GRPID=6
 SET_4,3,3,-0.03
###################################
#####   CONTACT DEFINITIONS   #####
###################################
!CONTACT, INTERACTION=FSLID, GRPID=1, DAMP_ALPHA=1.0E-2, DAMP_GACT=2.0E-2
CP1,0.0,5.0E+2
###################################
#####         MATERIAL        #####
###################################
!MATERIAL, NAME=MATERIAL_1
!ELASTIC
 1.00000000E+03, 3.00000000E-01
###################################
#####       STEP CONTROL      #####
###################################
!STEP, SUBSTEPS=2, CONVERG=1.0e-6
BOUNDARY,1
BOUNDARY,2
BOUNDARY,3
BOUNDARY,4
CONTACT,1
!STEP, SUBSTEPS=2, CONVERG=1.0e-6
BOUNDARY,1
BOUNDARY,2
BOUNDARY,3
BOUNDARY,5
CONTACT,1
!STEP, SUBSTEPS=4, CONVERG=1.0e-6
BOUNDARY,1
BOUNDARY,2
BOUNDARY,3
BOUNDARY,6
CONTACT,1
!END
