##############################################################
## Cutback of a MORTAR=YES contact pair where a slave face in
## contact loses it (issue #924). Three copies of
## 2box_hex_mortar, the upper boxes lifted by 0.05, form one
## contact pair: X at x=0, R at x=2 and L at x=4. SYM_X does
## not hold the upper box of R, whose top is moved in x.
## Step 2 slides R by 0.53 and lowers L by 0.25 in one
## increment: two slave faces of R slide off the master and L
## comes into contact. The Newton iteration does not converge
## within MAXITER=2 and the increment is cut back to 0.05.
## Step 3 lowers X by 0.25 in one increment and is cut back in
## the same way.
## Without restoring the segment states, t=1.05 is accepted
## without the contact force of the two faces of R. Without
## restoring the contact states of the integration points,
## t=2.05 is accepted with no contact force on X. The failing
## residuals are about 13 and 11 times CONVERG. Recheck the
## failures without the restores when changing the gaps, the
## displacements, the increments, MAXITER or CONVERG.
##############################################################
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!CONTACT_ALGO,TYPE=ALAGRANGE,AUGITER=3
!WRITE,RESULT,FREQUENCY=1
!OUTPUT_RES
DISP,ON
NSTRESS,OFF
NMISES,OFF
CONTACT_NFORCE,ON
CONTACT_STATE,ON
!WRITE,LOG
!SOLVER,METHOD=CG,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-06, 1.00, 0.0
 0.100, 0.100
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!BOUNDARY, GRPID=1
 SYM_X,1,1
 SYM_Y,2,2
 BOTTOM,3,3
!BOUNDARY, GRPID=2
 TOP_X,3,3,-0.045
 TOP_R,1,1,0
 TOP_R,3,3,-0.0504
 TOP_L,3,3,-0.03
!BOUNDARY, GRPID=3
 TOP_X,3,3,0
 TOP_R,1,1,0.53
 TOP_R,3,3,0
 TOP_L,3,3,-0.25
!BOUNDARY, GRPID=4
 TOP_X,3,3,-0.25
 TOP_R,1,1,0
 TOP_R,3,3,0
 TOP_L,3,3,0
###################################
#####   CONTACT DEFINITIONS   #####
###################################
!CONTACT, INTERACTION=FSLID, GRPID=1, MORTAR=YES
CP1,0.0
###################################
#####         MATERIAL        #####
###################################
!MATERIAL, NAME=MATERIAL_1
!ELASTIC
 1.00000000E+03, 3.00000000E-01
###################################
#####       STEP CONTROL      #####
###################################
!AUTOINC_PARAM, NAME=AP1
 0.25, 1000, 1000, 1000, 1
 1.25, 0, 0, 0, 1
 0.05, 5
!STEP, MAXITER=8, SUBSTEPS=1, CONVERG=1.0E-4
BOUNDARY,1
BOUNDARY,2
CONTACT,1
!STEP, INC_TYPE=AUTO, SUBSTEPS=100, MAXITER=2, CONVERG=1.0E-4, AUTOINCPARAM=AP1
 1.0, 1.0, 1.0E-4, 1.0
BOUNDARY,1
BOUNDARY,3
CONTACT,1
!STEP, INC_TYPE=AUTO, SUBSTEPS=100, MAXITER=2, CONVERG=1.0E-4, AUTOINCPARAM=AP1
 1.0, 1.0, 1.0E-4, 1.0
BOUNDARY,1
BOUNDARY,4
CONTACT,1
!END
