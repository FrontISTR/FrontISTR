# Regression test for CONTACT_OWNER=SLAVE (see contact_owner.txt).
# A slave block is dragged 4.5 along a master plate of length 8 that node-based
# partitioning cuts, so the slave nodes slide from one domain's share of the
# master surface into another's.  The slave-owner scheme gives the slave-owning
# rank the whole master surface, so the answer must not depend on the number of
# domains.
# At the two domains ctest uses, the master-owner scheme also stays inside the
# compare_res.pl tolerance, so this test guards the slave-owner code path; it does
# not detect the master-owner defect.
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!CONTACT_ALGO,TYPE=SLAGRANGE
!WRITE,LOG
!WRITE,RESULT,FREQUENCY=9999
!WRITE,VISUAL,FREQUENCY=9999
!OUTPUT_RES
DISP,ON
REACTION,ON
NSTRAIN,OFF
NSTRESS,ON
NMISES,ON
ESTRAIN,OFF
ESTRESS,OFF
CONTACT_NFORCE,ON
CONTACT_FRICTION,ON
CONTACT_RELVEL,ON
CONTACT_STATE,ON
CONTACT_NTRACTION,ON
CONTACT_FTRACTION,ON
# CONT_AREA has no !OUTPUT_RES keyword of its own - m_out.f90 defines only
# CONTACT_NFORCE/FRICTION/RELVEL/STATE/NTRACTION/FTRACTION.  It is covered
# indirectly: make_result.f90 computes the two tractions above as force divided
# by CONT_AREA, so an area that is wrong on one rank shows up directly in
# CONTACT_NTRACTION and CONTACT_FTRACTION.
!SOLVER,METHOD=GMRES,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-08, 1.00, 0.0
 0.100, 0.100
!BOUNDARY, GRPID=1
 FIX,1,3,0.0
!BOUNDARY, GRPID=2
 MOVE,1,1,4.5
 MOVE,2,2,0.0
!BOUNDARY, GRPID=2
 MOVE,3,3,-0.05
!CONTACT, INTERACTION=FSLID, GRPID=1
CP1, 0.3, 50.0
!MATERIAL, NAME=MAT1
!ELASTIC
1000, 0.3
!STEP, INC_TYPE=AUTO, SUBSTEPS=90
0.111111, 1.0, 1E-5, 0.111111
BOUNDARY,1
BOUNDARY,2
CONTACT,1
!VISUAL, method=PSR
!surface_num=1
!surface 1
!output_type = BIN_VTK
!END
