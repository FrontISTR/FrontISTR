###################################################################################
##### Force-controlled wedge: a block on a ramp of slope s = 0.115 held there only
##### by the friction of the contact (mu = 0.2).  The equilibrium of the whole block
##### at full load gives the total contact normal force 2*F/(c*(s+mu)) = 5624.1 N,
##### c = 1/sqrt(1+s^2), the factor 2 because it is written on both sides of a pair.
##### With FRICTION_CONE=FROZEN the augmentation loop does not converge on this load
##### path and the run stops at t = 0.1.
###################################################################################
!VERSION
 5
!SOLUTION, TYPE=STATIC, NONLINEAR
!CONTACT_ALGO, TYPE=ALAGRANGE, AUGITER=5, FRICTION_CONE=FOLLOW
!WRITE,RESULT,FREQUENCY=10
!WRITE,LOG
!OUTPUT_RES
DISP,ON
REACTION,ON
NSTRAIN,OFF
NSTRESS,OFF
NMISES,ON
CONTACT_NFORCE,ON
CONTACT_FRICTION,ON
CONTACT_STATE,ON
!SOLVER,METHOD=BiCGSTAB,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-08, 1.00, 0.0
 0.100, 0.100
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!SPRING
 ALL, 1, -10
 ALL, 2, -10
 ALL, 3, -10
!BOUNDARY, GRPID=1
 M_BOT, 1, 3, 0.0
 S_TOP, 2, 3, 0.0
!CLOAD, GRPID=1, AMP=TIMC1
 S_BACK, 1, 4.400000e+01
###################################
#####   CONTACT DEFINITIONS   #####
###################################
!CONTACT_PARAM, NAME=CPARAM1
 1.0e-4, 5.0e-3, 1.0e-2, 1.0e-4
 1.0e-6, -1.0e-3, 1.0, -1.0e-8, 1.05
!CONTACT, GRPID=1, INTERACTION=FSLID, CONTACTPARAM=CPARAM1
 CP1, 0.2, 0.1
###################################
#####          STEP           #####
###################################
!STEP, SUBSTEPS=10, MAXITER=25, CONVERG=1.0e-4, CONVERG_DDISP=1.0e-4, MAXRES=1.0e5, MAXCONTITER=10
 LOAD, 1
 CONTACT, 1
 BOUNDARY, 1
!END
