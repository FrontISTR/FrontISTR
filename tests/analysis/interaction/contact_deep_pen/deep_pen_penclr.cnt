###################################################################
# The box of deep_pen is pressed in the same way with PENCLR_FREE=0.5
# on the fourth data line of !CONTACT_PARAM. The penetration of 0.3
# exceeds 0.5 times the reference length 0.5, so no slave node is
# judged as contact and the box passes through the fixed box.
# Only the displacement and the contact are written, since the
# stress of a box moving as a rigid body is noise of the solver.
###################################################################
###################################
#####   SOLVER INFORMATION    #####
###################################
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!CONTACT_ALGO,TYPE=SLAGRANGE
!WRITE,RESULT,FREQUENCY=10
!OUTPUT_RES
DISP,ON
REACTION,OFF
NSTRAIN,OFF
NSTRESS,OFF
NMISES,OFF
ESTRAIN,OFF
ESTRESS,OFF
EMISES,OFF
ISTRAIN,OFF
ISTRESS,OFF
CONTACT_NFORCE,ON
CONTACT_FRICTION,ON
CONTACT_RELVEL,ON
CONTACT_STATE,ON
CONTACT_FTRACTION,ON
CONTACT_NTRACTION,ON
!OUTPUT_VIS
DISP,ON
REACTION,ON
NSTRAIN,OFF
NSTRESS,ON
NMISES,ON
CONTACT_NFORCE,ON
CONTACT_FRICTION,ON
CONTACT_RELVEL,ON
CONTACT_STATE,ON
CONTACT_FTRACTION,ON
CONTACT_NTRACTION,ON
!WRITE,LOG
!SOLVER,METHOD=CG,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-06, 1.00, 0.0
 0.100, 0.100
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!BOUNDARY, GRPID=1
 SET_1,1,1
!BOUNDARY, GRPID=2
 SET_2,2,2
!BOUNDARY, GRPID=3
 SET_3,3,3
!BOUNDARY, GRPID=4
 SET_4,3,3,-0.6
###################################
#####   CONTACT DEFINITIONS   #####
###################################
!CONTACT_PARAM, NAME=CPARAM1
 1.0e-2,  5.0e-3,  1.0e-2,  1.0e-4
 1.0e-2, -1.0e-6,  1.0,    -1.0e-2
 1.0e-3
 0.5
!CONTACT, INTERACTION=FSLID, GRPID=1, CONTACTPARAM=CPARAM1
CP1,0.0,5.0E+2
###################################
#####         MATERIAL        #####
###################################
!MATERIAL, NAME=MATERIAL_1
!ELASTIC
 1.00000000E+03, 3.00000000E-01
###################################
#####       STEP CONTROL      #####
###################################
!STEP, SUBSTEPS=1
BOUNDARY,1
BOUNDARY,2
BOUNDARY,3
BOUNDARY,4
CONTACT,1
###################################
#####      FOR VISUALIZER     #####
###################################
!WRITE,VISUAL,FREQUENCY=10
!VISUAL, method=PSR
!surface_num=1
!surface 1
!output_type = BIN_VTK
!END
