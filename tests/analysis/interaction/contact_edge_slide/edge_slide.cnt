###################################################################
# The master surface wraps the convex edge at x=0 of the lower block:
# the top faces of its four elements and the x=0 face of the first
# one. The slave block is pressed down by 0.01 and slid 0.5 in +x, so
# that its nodes at x=0.75 pass from the top face of the first element
# onto the second one while in contact. The tracking has to take the
# nearest master surface: the face across the edge holds the node at a
# depth of about one element and is accepted as well, since the depth
# of a node in contact is not limited (PENCLR_NOCHECK).
###################################################################
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!CONTACT_ALGO, TYPE=SLAGRANGE
!WRITE,RESULT,FREQUENCY=10
!OUTPUT_RES
DISP,ON
REACTION,ON
NSTRAIN,OFF
NSTRESS,OFF
NMISES,OFF
ESTRAIN,OFF
ESTRESS,OFF
EMISES,OFF
CONTACT_NFORCE,ON
CONTACT_STATE,ON
!WRITE,LOG
!SOLVER,METHOD=CG,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-08, 1.00, 0.0
 0.100, 0.100
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!BOUNDARY, GRPID=1
 LOWER_BOTTOM, 1, 3, 0.0
!BOUNDARY, GRPID=2
 UPPER_TOP, 1, 1, 0.5
 UPPER_TOP, 2, 2, 0.0
 UPPER_TOP, 3, 3, -0.01
###################################
#####   CONTACT DEFINITIONS   #####
###################################
!CONTACT, INTERACTION=FSLID, GRPID=1
 CP1, 0.0, 1.0E+5
###################################
#####         MATERIAL        #####
###################################
!MATERIAL, NAME=MAT1
!ELASTIC
 1.00000000E+03, 3.00000000E-01
###################################
#####       STEP CONTROL      #####
###################################
!STEP, SUBSTEPS=10
 BOUNDARY, 1
 BOUNDARY, 2
 CONTACT, 1
!END
