###################################################################
# The model of edge_slide with MORTAR=YES. The integration points of
# the slave surface start above the top face of the first element,
# within reach of the x=0 face across the convex edge, so the scan of
# the candidates has to take the nearest master surface as well. On
# the face across the edge the integration points stay bound at a
# depth of about one element and carry about a third less contact
# force.
###################################################################
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!CONTACT_ALGO, TYPE=ALAGRANGE
!WRITE,RESULT,FREQUENCY=10
!OUTPUT_RES
DISP,ON
REACTION,ON
NSTRAIN,OFF
NSTRESS,OFF
NMISES,OFF
ESTRAIN,OFF
ESTRESS,OFF
EMISES,OFF
CONTACT_NFORCE,ON
CONTACT_STATE,ON
!WRITE,LOG
!SOLVER,METHOD=CG,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-08, 1.00, 0.0
 0.100, 0.100
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!BOUNDARY, GRPID=1
 LOWER_BOTTOM, 1, 3, 0.0
!BOUNDARY, GRPID=2
 UPPER_TOP, 1, 1, 0.5
 UPPER_TOP, 2, 2, 0.0
 UPPER_TOP, 3, 3, -0.01
###################################
#####   CONTACT DEFINITIONS   #####
###################################
!CONTACT, INTERACTION=FSLID, GRPID=1, MORTAR=YES
 CP1, 0.0
###################################
#####         MATERIAL        #####
###################################
!MATERIAL, NAME=MAT1
!ELASTIC
 1.00000000E+03, 3.00000000E-01
###################################
#####       STEP CONTROL      #####
###################################
!STEP, SUBSTEPS=10
 BOUNDARY, 1
 BOUNDARY, 2
 CONTACT, 1
!END
