#  Control File for FISTR
## Analysis Control
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!WRITE,RESULT,FREQUENCY=20
!WRITE,LOG
#!WRITE,VISUAL
!OUTPUT_RES
DISP,ON
REACTION,ON
CONTACT_NFORCE,ON
CONTACT_FRICTION,ON
CONTACT_STATE,ON
CONTACT_NTRACTION,ON
CONTACT_FTRACTION,ON
## Solver Control
### Boundary Condition
!BOUNDARY, GRPID=1
 ALL,  3, 3, 0.0
 BASE, 1, 2, 0.0
 PUSH, 1, 1, 0.2
!CLOAD, GRPID=1
 TOP, 2, -2.0
!CONTACT_ALGO, TYPE=ALAGRANGE
!CONTACT, GRPID=1, INTERACTION=FSLID
 CP1, 0.3
### STEP
!STEP, SUBSTEPS=20, CONVERG=1.0e-8
 BOUNDARY, 1
 LOAD, 1
 CONTACT, 1
### Material
!MATERIAL, NAME=MAT1
!ELASTIC
 1100.0, 0.0
### Solver Setting
!SOLVER,METHOD=BiCGSTAB,PRECOND=1,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-8, 1.0, 0.0
## Post Control
!VISUAL,method=PSR
!surface_num=1
!surface 1
!output_type=VTK
!END
