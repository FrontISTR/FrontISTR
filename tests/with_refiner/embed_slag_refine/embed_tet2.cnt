###################################
# embed_tet2 of analysis/interaction/embed_slag_iter, refined once by fistr1
# (refine.txt). All 275 nodes of the refined embedded part must be caught in
# the first scan, as in serial, also when the partitioner has replicated them
# to the owners of the host elements only before the refinement.
###################################
#####   SOLVER INFORMATION    #####
###################################
!VERSION
 3
!SOLUTION, TYPE=STATIC, NONLINEAR
!CONTACT_ALGO, TYPE=SLAGRANGE
!WRITE,LOG
!SOLVER,METHOD=CG,PRECOND=3,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-06, 1.00, 0.0
 0.100, 0.100
###################################
#####   BOUNDARY CONDITIONS   #####
###################################
!BOUNDARY, GRPID=1
 SET_1,1,1
 SET_1,2,2
 SET_1,3,3
!DLOAD, GRPID=1
SURF_1,S,0.1
!CONTACT_PARAM, NAME=CPARAM1
1.0e-4,  5.0e-3,  1.0e-2,  1.0e-4
1.0e-6,  1.0e-6,  1.0,    -1.0e-8,  1.05
!EMBED, CONTACTPARAM=CPARAM1, GRPID=1
IP1
###################################
#####         MATERIAL        #####
###################################
!MATERIAL, NAME=MATERIAL_2
!ELASTIC
 1000, 0.3
!MATERIAL, NAME=MATERIAL_1
!ELASTIC
 100, 0.3
###################################
#####      STEP CONTROL      #####
###################################
!STEP, SUBSTEPS=1, CONVERG=1.000E-07
BOUNDARY,1
LOAD,1
CONTACT,1
!END
