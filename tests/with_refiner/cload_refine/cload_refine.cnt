# !CLOAD on a refined mesh. The refinement adds nodes to the node group TOP, and the load is
# applied to each of them, so a warning is shown for TOP. The load on the single node 9 is not warned.
!VERSION
 3
!SOLUTION, TYPE=STATIC
!BOUNDARY
 FIX, 1, 3, 0.0
!CLOAD
 TOP, 3, -1.0
 9, 1, 1.0
!MATERIAL, NAME=M1
!ELASTIC
 1.0E+05, 0.3
!SOLVER, METHOD=CG, PRECOND=1, ITERLOG=NO, TIMELOG=NO
 10000, 1
 1.0E-8, 1.0, 0.0
!WRITE, RESULT
!END
