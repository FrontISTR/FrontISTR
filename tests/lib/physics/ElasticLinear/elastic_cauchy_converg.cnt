!VERSION
    3
!SOLUTION, TYPE = NLSTATIC
# Linear elastic with the updated Lagrangian formulation (!ELASTIC, CAUCHY), uniaxial load.
# The stress increment must keep double precision: with a strict convergence criterion
# (1e-10) the Newton iteration has to reach it instead of stalling at round-off of single precision.
!BOUNDARY, GRPID = 1
        1,        1,        3,   0.0000000000E+00
        4,        1,        1,   0.0000000000E+00
        4,        3,        3,   0.0000000000E+00
        5,        1,        2,   0.0000000000E+00
        8,        1,        1,   0.0000000000E+00
!CLOAD, GRPID = 1
        2,        1,   250.0
        3,        1,   250.0
        6,        1,   250.0
        7,        1,   250.0
!STEP, SUBSTEPS = 5, CONVERG=1.E-10, MAXITER=20
  BOUNDARY,    1
  LOAD,        1
!MATERIAL, NAME=M1
!ELASTIC, CAUCHY
  1.0E+04,   0.3
!WRITE, RESULT, FREQUENCY=5
!OUTPUT_RES
   ESTRESS, ON
!SOLVER, METHOD = DIRECTmf
!END
