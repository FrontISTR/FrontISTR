!VERSION
    3
!SOLUTION, TYPE = NLSTATIC
# Mises linear kinematic hardening (small strain), uniaxial stress, displacement control:
#   strain 0 -> 0.02 -> 1/110 (stress exactly 0) -> 1/110+0.015
# The back stress must survive the stress-free state, so reloading yields again at 1090.9:
#   hand-calc: sigma_xx = 1000+1.0e5*1.0e4/1.1e5*0.01 = 1090.9 after loading, 0 after
#   unloading, 1090.9+1.0e5*1.0e4/1.1e5*(0.015-0.010909) = 1128.1 after reloading;
#   equivalent plastic strain 1/110 until reloading, 1/110+(1128.1-1090.9)/1.0e4 = 0.012810 after
!BOUNDARY, GRPID = 1
        1,        1,        3,   0.0000000000E+00
        4,        1,        1,   0.0000000000E+00
        4,        3,        3,   0.0000000000E+00
        5,        1,        2,   0.0000000000E+00
        8,        1,        1,   0.0000000000E+00
!BOUNDARY, GRPID = 2
        2,        1,        1,   0.02
        3,        1,        1,   0.02
        6,        1,        1,   0.02
        7,        1,        1,   0.02
!BOUNDARY, GRPID = 3
        2,        1,        1,   -0.010909090909090909
        3,        1,        1,   -0.010909090909090909
        6,        1,        1,   -0.010909090909090909
        7,        1,        1,   -0.010909090909090909
!BOUNDARY, GRPID = 4
        2,        1,        1,   0.015
        3,        1,        1,   0.015
        6,        1,        1,   0.015
        7,        1,        1,   0.015
!STEP, SUBSTEPS = 5, CONVERG=1.E-8
  BOUNDARY,    1
  BOUNDARY,    2
!STEP, SUBSTEPS = 5, CONVERG=1.E-8
  BOUNDARY,    1
  BOUNDARY,    3
!STEP, SUBSTEPS = 5, CONVERG=1.E-8
  BOUNDARY,    1
  BOUNDARY,    4
!MATERIAL, NAME=M1
!ELASTIC, INFINITESIMAL
  10.0E+04,   0.3
!PLASTIC, HARDEN=KINEMATIC, INFINITESIMAL
  1000., 1.0E+04
!WRITE, RESULT, FREQUENCY=5
!OUTPUT_RES
   ESTRESS, ON
   PL_ISTRAIN, ON
!SOLVER, METHOD = DIRECTmf
!END
