!VERSION
    3
!SOLUTION, TYPE = NLSTATIC
# Mises perfect plasticity with the total Lagrangian formulation (!PLASTIC, KIRCHHOFF).
# Uniaxial: displacement 0 -> 0.012 (beyond yield) -> 0.006.
# The trial stress must start from the converged stress, so the unloading is elastic:
# the equivalent plastic strain does not change in the second step.
!BOUNDARY, GRPID = 1
        1,        1,        3,   0.0000000000E+00
        4,        1,        1,   0.0000000000E+00
        4,        3,        3,   0.0000000000E+00
        5,        1,        2,   0.0000000000E+00
        8,        1,        1,   0.0000000000E+00
!BOUNDARY, GRPID = 2
        2,        1,        1,   0.012
        3,        1,        1,   0.012
        6,        1,        1,   0.012
        7,        1,        1,   0.012
!BOUNDARY, GRPID = 3
        2,        1,        1,   -0.006
        3,        1,        1,   -0.006
        6,        1,        1,   -0.006
        7,        1,        1,   -0.006
!STEP, SUBSTEPS = 10, CONVERG=1.E-8
  BOUNDARY,    1
  BOUNDARY,    2
!STEP, SUBSTEPS = 10, CONVERG=1.E-8
  BOUNDARY,    1
  BOUNDARY,    3
!MATERIAL, NAME=M1
!ELASTIC
  10.0E+04,   0.3
!PLASTIC, KIRCHHOFF
  1000., 0.
!WRITE, RESULT, FREQUENCY=10
!OUTPUT_RES
   ESTRESS, ON
   PL_ISTRAIN, ON
!SOLVER, METHOD = CG, PRECOND = 3, ITERLOG = NO, TIMELOG = NO
  10000,       1
 1.0E-8,     1.0,     0.0
!END
