###################################
# Norton creep under a purely hydrostatic stress.
# All nodes are fixed and the temperature rises uniformly, so the stress is
# -3*K*alpha*dT with zero deviator and no creep strain develops.
###################################
!VERSION
 3
!SOLUTION, TYPE=NLSTATIC
!WRITE,LOG
!WRITE,RESULT,FREQUENCY=10
!OUTPUT_RES
EMISES,ON
!SOLVER,METHOD=CG,PRECOND=1,NSET=0,ITERLOG=NO,TIMELOG=NO
 5000, 1
 1.0e-08, 1.00, 0.0
 0.100, 0.100
!BOUNDARY, GRPID=1
 BEAM_1_SET_1,1,3
!TEMPERATURE, GRPID=1
 BEAM_1_SET_1,125.
!MATERIAL, NAME=MATERIAL1
!ELASTIC, INFINITESIMAL
 1.00000000E+03, 3.00000000E-01
!CREEP,TYPE=NORTON,INFINITESIMAL
 0.001, 1.0, 0.1
!STEP, TYPE=VISCO, CONVERG=1.0E-06, MAXITER=10
 0.1, 1.0
BOUNDARY,1
LOAD,1
!END
