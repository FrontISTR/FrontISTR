!VERSION
 5
!SOLUTION, TYPE=STATIC
# !EQUATION handled by elimination (MPCMETHOD=3): the MPC-reduced matrix is
# rebuilt at every step, while MUMPS keeps the factorization of step 1.
# Three load cases on the same constraints; steps 2 and 3 use MATRIX=REUSE.
# The reference results were produced by the same input without MATRIX=REUSE.
!BOUNDARY, GRPID=1
 bottom, 1, 3, 0.0
!CLOAD, GRPID=11
 top, 3, -1.0
!CLOAD, GRPID=12
 top, 1, 1.0
!CLOAD, GRPID=13
 top, 2, -1.0
!MATERIAL, NAME=M00001
!ELASTIC
 2.613E+04, 0.2
!SECTION, SECNUM=1, FORM361=FI
!STEP
 BOUNDARY, 1
 LOAD, 11
!STEP, MATRIX=REUSE
 BOUNDARY, 1
 LOAD, 12
!STEP, MATRIX=REUSE
 BOUNDARY, 1
 LOAD, 13
!SOLVER, METHOD=MUMPS, TIMELOG=YES, MPCMETHOD=3
!WRITE, RESULT, FREQUENCY=1
!OUTPUT_RES
 DISP, ON
 NSTRESS, ON
!END
